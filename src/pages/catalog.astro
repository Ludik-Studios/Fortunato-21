---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const adsenseEnabled = import.meta.env.PROD && adsenseClientId;
const gaMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const currentUser = Astro.locals.user;

// Cargar proyectos dinámicamente desde Astro Content Collections (src/data/projects/*.json)
const rawProjects = await getCollection('projects');
const projects = rawProjects.map((entry) => ({
	id: entry.id,
	...entry.data
}));

const categories = [
	{ label: 'Todos los proyectos', slug: 'all' },
	{ label: 'Videojuegos', slug: 'videojuegos' },
	{ label: 'Desarrollo Web', slug: 'web' },
	{ label: 'Marketing & Campañas', slug: 'marketing' },
	{ label: 'Diseño & Branding', slug: 'branding' },
	{ label: 'Multimedia', slug: 'multimedia' },

];
---

<Layout title="Catálogo de Proyectos | Ludik Studios" description="Conoce todos los proyectos realizados por Ludik Studios: videojuegos, desarrollo web, campañas de marketing y diseño." lang="es" adsenseClientId={adsenseEnabled ? adsenseClientId : undefined} gaMeasurementId={gaMeasurementId}>
	<main class="catalog-shell">
		<!-- BARRA SUPERIOR -->
		<header class="topbar">
			<a class="brand" href="/" aria-label="Inicio de Ludik Hub" data-ga-event="catalog_brand">
				<span class="brand-card" aria-hidden="true">
					<span class="brand-card-corner">K<i>♦</i></span>
					<span class="brand-card-suit">♦</span>
					<span class="brand-card-corner brand-card-corner-bottom">K<i>♦</i></span>
				</span>
				<span>LUDIK <b>HUB</b></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="/">Inicio</a>
				<a href="/catalog/" aria-current="page" class="nav-active" data-ga-event="catalog_nav">Catálogo</a>
				<a href="/donate/" data-ga-event="donate_nav">Apóyanos</a>
				{currentUser ? (
					<>
						{Astro.locals.isAdmin && <a href="/admin/">Administración</a>}
						<form class="nav-logout" method="POST" action="/api/auth/logout"><button type="submit">Cerrar sesión</button></form>
					</>
				) : (
					<>
						<a href="/login/">Iniciar sesión</a>
						<a href="/register/">Crear cuenta</a>
					</>
				)}
				<a href="/about/" data-ga-event="about_nav">Acerca de Ludik</a>
			</nav>
			<a class="studio-link" href="/about/" data-ga-event="studio_link">Un proyecto de Ludik Studios <span aria-hidden="true">↗</span></a>
		</header>

		<!-- ENCABEZADO DEL CATÁLOGO -->
		<section class="catalog-hero" aria-labelledby="catalog-title">
			<div class="hero-badge">PORTAFOLIO & CREACIONES</div>
			<h1 id="catalog-title">CATÁLOGO DE <em>PROYECTOS</em></h1>
			<p class="catalog-subtitle">
				Descubre las creaciones multidisciplinarias de Ludik Studios: desde videojuegos independientes en WebGL hasta plataformas digitales, identidades de marca y campañas estratégicas.
			</p>

			<!-- FILTROS POR CATEGORÍA -->
			<div class="category-filters" role="tablist" aria-label="Filtrar por categoría">
				{categories.map((cat, idx) => (
					<button
						type="button"
						class={`filter-btn ${idx === 0 ? 'active' : ''}`}
						data-filter={cat.slug}
						role="tab"
						aria-selected={idx === 0 ? 'true' : 'false'}
					>
						{cat.label}
					</button>
				))}
			</div>
		</section>

		<!-- LISTADO DE PROYECTOS -->
		<section class="projects-list" aria-label="Listado de proyectos">
			{projects.map((proj) => (
				<article class="project-card" data-category={proj.categorySlug} id={`proj-${proj.id}`}>
					<!-- COLUMNA PRINCIPAL DEL PROYECTO -->
					<div class="project-main">
						<!-- THUMBNAIL / COVER IMAGE -->
						<div class="project-cover-thumb">
							{proj.media?.coverImage ? (
								<img src={proj.media.coverImage} alt={`Portada de ${proj.title}`} class="cover-thumb-img" />
							) : (
								<div class="cover-thumb-placeholder">
									<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
										<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
										<circle cx="8.5" cy="8.5" r="1.5"/>
										<polyline points="21 15 16 10 5 21"/>
									</svg>
									<span>Sin portada</span>
								</div>
							)}
						</div>
						<div class="project-header">
							<div class="project-meta">
								<span class="category-badge">{proj.category}</span>
								<span class="year-badge">{proj.year}</span>
								<span class={`status-badge status-${proj.status.toLowerCase()}`}>{proj.status}</span>
							</div>
							<h2 class="project-title">{proj.title}</h2>
							<p class="project-tagline">{proj.tagline}</p>
						</div>

						<p class="project-description">{proj.description}</p>

						<!-- APARTADO MULTIMEDIA (VACÍO PARA AGREGAR VIDEOS E IMÁGENES) -->
						<div class="media-section">
							<div class="media-section-header">
								<span class="media-title">Galería & Recursos Multimedia</span>
								<small class="media-hint">Espacio reservado para video y capturas</small>
							</div>

							<div class="media-container">
								<!-- SLOT DE VIDEO -->
								<div class="media-slot media-slot--video">
									{proj.media?.videoUrl ? (
										proj.media.videoUrl.includes('youtube.com') || proj.media.videoUrl.includes('youtu.be') ? (
											<iframe src={proj.media.videoUrl} title={`Video ${proj.title}`} allowfullscreen class="media-real-video"></iframe>
										) : (
											<video src={proj.media.videoUrl} controls class="media-real-video"></video>
										)
									) : (
										<div class="media-placeholder">
											<svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
												<path d="M8 5v14l11-7z"/>
											</svg>
											<strong>Trailer o Demostración</strong>
											<span>Espacio reservado para video del proyecto</span>
										</div>
									)}
								</div>

								<!-- SLOTS DE CAPTURAS E IMÁGENES -->
								<div class="media-images-grid">
									{proj.media?.gallery && proj.media.gallery.length > 0 ? (
										proj.media.gallery.slice(0, 2).map((imgUrl, i) => (
											<div class="media-slot media-slot--image">
												<img src={imgUrl} alt={`Captura ${i + 1} de ${proj.title}`} class="media-real-image" />
											</div>
										))
									) : (
										<>
											<div class="media-slot media-slot--image">
												<div class="media-placeholder">
													<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
														<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
														<circle cx="8.5" cy="8.5" r="1.5"/>
														<polyline points="21 15 16 10 5 21"/>
													</svg>
													<strong>Captura 1</strong>
													<span>Espacio para imagen</span>
												</div>
											</div>
											<div class="media-slot media-slot--image">
												<div class="media-placeholder">
													<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
														<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
														<circle cx="8.5" cy="8.5" r="1.5"/>
														<polyline points="21 15 16 10 5 21"/>
													</svg>
													<strong>Captura 2</strong>
													<span>Espacio para imagen</span>
												</div>
											</div>
										</>
									)}
								</div>
							</div>
						</div>

						<!-- BOTONES DE ACCIÓN (SI APLICA) -->
						<div class="project-actions">
							{proj.playUrl && (
								<a href={proj.playUrl} class="btn-action-primary">
									<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
									{proj.categorySlug === 'videojuegos' ? 'Jugar Ahora' : 'Ver Plataforma'}
								</a>
							)}
							<a href={proj.detailUrl || `/projects/${proj.id}`} class="btn-action-secondary">
								Detalles y Comentarios →
							</a>
						</div>
					</div>

					<!-- COLUMNA LATERAL: INVOLUCRADOS, ROL Y CONTACTO -->
					<aside class="project-sidebar">
						<div class="team-card">
							<h3>Involucrados en el Proyecto</h3>
							<ul class="team-list">
								{proj.team.map((member) => (
									<li class="team-member">
										<span class="member-role">{member.role}</span>
										<strong class="member-name">{member.name}</strong>
										<a href={`mailto:${member.contact}`} class="member-contact">
											{member.contact}
										</a>
									</li>
								))}
							</ul>
						</div>
					</aside>
				</article>
			))}
		</section>

		<!-- FOOTER -->
		<footer class="catalog-footer">
			<div class="update-note">
				<span class="update-icon" aria-hidden="true">✳</span>
				<p><b>Ludik Studios Portfolio</b><br />Videojuegos, plataformas y estrategias independientes.</p>
			</div>
			<a class="about-link" href="mailto:hello@ludikstudios.com">Contacto de Negocios y Proyectos <span aria-hidden="true">↗</span></a>
		</footer>
	</main>
</Layout>

<script>
	// Filtros dinámicos por categoría
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

	filterButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const targetFilter = btn.getAttribute('data-filter');

			// Actualizar botón activo
			filterButtons.forEach((b) => {
				b.classList.remove('active');
				b.setAttribute('aria-selected', 'false');
			});
			btn.classList.add('active');
			btn.setAttribute('aria-selected', 'true');

			// Filtrar tarjetas con transición suave
			projectCards.forEach((card) => {
				const cardCat = card.getAttribute('data-category');
				if (targetFilter === 'all' || cardCat === targetFilter) {
					card.style.display = 'grid';
				} else {
					card.style.display = 'none';
				}
			});
		});
	});
</script>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) {
		min-width: 320px;
		min-height: 100vh;
		color: #fff;
		position: relative;
		background-color: #0b0718;
		background-image:
			radial-gradient(ellipse at 50% 0%, rgba(54, 42, 103, 0.65), transparent 70%),
			linear-gradient(180deg, #0b0718 0%, #150f29 100%);
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
	}

	.catalog-shell {
		position: relative;
		z-index: 1;
		width: min(1320px, 100%);
		min-height: 100vh;
		margin-inline: auto;
		padding: 24px 24px 48px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	/* TOPBAR */
	.topbar {
		min-height: 52px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding-bottom: 16px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		text-decoration: none;
		color: #fff;
		font-family: 'Arial Black', Impact, sans-serif;
		font-size: 20px;
		letter-spacing: 1px;
	}
	.brand b { color: #ffcb76; }
	.brand-card {
		width: 26px;
		height: 38px;
		border-radius: 4px;
		background: #fff;
		color: #c93b4f;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2px 3px;
		font-size: 8px;
		font-weight: 900;
		box-shadow: 0 4px 10px rgba(201, 59, 79, 0.4);
	}
	.brand-card-suit { font-size: 11px; align-self: center; }
	.brand-card-corner-bottom { transform: rotate(180deg); }

	.topbar nav {
		display: flex;
		align-items: center;
		gap: 20px;
	}
	.topbar nav a {
		color: rgba(255, 255, 255, 0.75);
		text-decoration: none;
		font-size: 14px;
		font-weight: 600;
		transition: color 0.2s ease;
	}
	.topbar nav a:hover,
	.topbar nav a.nav-active {
		color: #ffcb76;
	}
	.nav-logout button {
		background: none;
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #fff;
		padding: 5px 12px;
		border-radius: 4px;
		font-size: 12px;
		cursor: pointer;
	}
	.studio-link {
		color: #ffcb76;
		text-decoration: none;
		font-size: 12px;
		font-weight: 700;
	}

	/* HERO */
	.catalog-hero {
		padding: 12px 0 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.hero-badge {
		font-size: 10px;
		font-weight: 900;
		color: #ffcb76;
		letter-spacing: 2px;
		margin-bottom: 8px;
	}
	.catalog-hero h1 {
		margin: 0;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: clamp(34px, 5vw, 56px);
		letter-spacing: 1.5px;
		line-height: 1.05;
	}
	.catalog-hero h1 em { color: #ffcb76; font-style: normal; }
	.catalog-subtitle {
		max-width: 820px;
		margin: 14px 0 28px;
		font-size: 16px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.78);
	}

	/* FILTROS */
	.category-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.filter-btn {
		padding: 8px 18px;
		border-radius: 20px;
		background: rgba(14, 27, 52, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.8);
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.filter-btn:hover {
		border-color: rgba(255, 203, 118, 0.4);
		color: #fff;
	}
	.filter-btn.active {
		background: #ffcb76;
		border-color: #ffcb76;
		color: #120a26;
	}

	/* LISTADO DE PROYECTOS */
	.projects-list {
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.project-card {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: 32px;
		padding: 32px;
		border-radius: 12px;
		background: rgba(36, 26, 70, 0.6);
		border: 1px solid rgba(132, 107, 214, 0.2);
		backdrop-filter: blur(8px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
		transition: border-color 0.2s ease;
	}
	.project-card:hover {
		border-color: rgba(255, 203, 118, 0.3);
	}

	/* COLUMNA PRINCIPAL */
	.project-main {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	/* COVER THUMBNAIL */
	.project-cover-thumb {
		width: 100%;
		aspect-ratio: 21 / 9;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(132, 107, 214, 0.2);
		background: rgba(18, 12, 38, 0.6);
		flex-shrink: 0;
	}
	.cover-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.cover-thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		color: rgba(255, 255, 255, 0.25);
		font-size: 11px;
		background: repeating-linear-gradient(
			-45deg,
			rgba(54, 42, 103, 0.06),
			rgba(54, 42, 103, 0.06) 10px,
			transparent 10px,
			transparent 20px
		);
	}
	.cover-thumb-placeholder svg { opacity: 0.35; }

	.project-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 10px;
	}
	.category-badge {
		font-size: 9px;
		font-weight: 900;
		letter-spacing: 1px;
		text-transform: uppercase;
		padding: 3px 8px;
		border-radius: 3px;
		background: #ffcb76;
		color: #120a26;
	}
	.year-badge {
		font-size: 10px;
		font-weight: 700;
		padding: 3px 8px;
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.1);
		color: rgba(255, 255, 255, 0.7);
	}
	.status-badge {
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.5px;
		padding: 3px 8px;
		border-radius: 3px;
		background: rgba(56, 189, 248, 0.15);
		color: #38bdf8;
		border: 1px solid rgba(56, 189, 248, 0.3);
	}
	.status-disponible {
		background: rgba(34, 197, 94, 0.15);
		color: #4ade80;
		border-color: rgba(34, 197, 94, 0.3);
	}

	.project-title {
		margin: 0;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: 28px;
		letter-spacing: 1px;
		color: #fff;
	}
	.project-tagline {
		margin: 4px 0 0;
		font-size: 14px;
		font-weight: 600;
		color: #ffcb76;
	}
	.project-description {
		margin: 0;
		font-size: 15px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.85);
	}

	/* RECURSOS MULTIMEDIA (VIDEOS E IMÁGENES) */
	.media-section {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		border-radius: 8px;
		background: rgba(18, 12, 38, 0.65);
		border: 1px solid rgba(132, 107, 214, 0.15);
	}
	.media-section-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.media-title {
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 1px;
		color: #ffcb76;
		text-transform: uppercase;
	}
	.media-hint {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.45);
	}

	.media-container {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
	}
	.media-images-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}

	.media-slot {
		position: relative;
		border-radius: 6px;
		overflow: hidden;
		background: rgba(32, 23, 62, 0.5);
		border: 1px dashed rgba(132, 107, 214, 0.25);
		transition: border-color 0.2s ease, background 0.2s ease;
	}
	.media-slot:hover {
		border-color: rgba(255, 203, 118, 0.45);
		background: rgba(54, 42, 103, 0.55);
	}
	.media-slot--video {
		aspect-ratio: 16 / 9;
	}
	.media-slot--image {
		aspect-ratio: 16 / 9;
	}
	.media-slot :global(img),
	.media-slot :global(video),
	.media-slot :global(iframe) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		border: 0;
	}
	.media-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 6px;
		text-align: center;
		padding: 16px;
		color: rgba(255, 255, 255, 0.5);
	}
	.media-placeholder svg {
		color: #ffcb76;
		opacity: 0.85;
	}
	.media-placeholder strong {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.85);
	}
	.media-placeholder span {
		font-size: 10px;
		color: rgba(255, 255, 255, 0.45);
	}

	/* ACCIONES DEL PROYECTO */
	.project-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		margin-top: 4px;
	}
	.btn-action-primary {
		padding: 10px 20px;
		border-radius: 6px;
		background: linear-gradient(135deg, #ffcb76 0%, #e5a438 100%);
		color: #120a26;
		font-family: 'Arial Black', Impact, sans-serif;
		font-size: 12px;
		letter-spacing: 0.5px;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		box-shadow: 0 4px 14px rgba(255, 203, 118, 0.25);
		transition: transform 0.2s ease;
	}
	.btn-action-primary:hover {
		transform: translateY(-2px);
	}
	.btn-action-secondary {
		color: #ffcb76;
		text-decoration: none;
		font-size: 13px;
		font-weight: 700;
		transition: opacity 0.2s ease;
	}
	.btn-action-secondary:hover {
		opacity: 0.8;
		text-decoration: underline;
	}

	/* COLUMNA LATERAL (INVOLUCRADOS) */
	.project-sidebar {
		display: flex;
		flex-direction: column;
	}
	.team-card {
		height: 100%;
		padding: 22px;
		border-radius: 8px;
		background: rgba(32, 23, 62, 0.55);
		border: 1px solid rgba(132, 107, 214, 0.18);
	}
	.team-card h3 {
		margin: 0 0 16px;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: 16px;
		letter-spacing: 0.5px;

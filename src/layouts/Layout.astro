---

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	adsenseClientId?: string;
	gaMeasurementId?: string;
}

import AnalyticsConsent from '../components/AnalyticsConsent.astro';

const {
	title = 'Ludik Hub | Juegos de Ludik Studios',
	description = 'Juegos independientes de Ludik Studios: pequeños mundos hechos con curiosidad.',
	lang = 'es',
	adsenseClientId = 'ca-pub-4458613411229519',
	gaMeasurementId,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
	<head>  
     <meta charset="utf-8" />
	 <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4458613411229519" crossorigin="anonymous"></script>
     <meta name="google-adsense-account" content="ca-pub-4458613411229519" /> 
     <meta name="viewport" content="width=device-width, initial-scale=1" />
     <meta name="theme-color" content="#6758db" />
     <meta name="description" content={description} />
     <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
     <link rel="icon" href="/favicon.ico" />
     <meta name="generator" content={Astro.generator} />
     <title>{title}</title>
    </head>   
	<body>
		<slot />
		{gaMeasurementId && <AnalyticsConsent measurementId={gaMeasurementId} />}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

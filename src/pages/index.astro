---


import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';

const unityGameUrl = import.meta.env.PUBLIC_UNITY_GAME_URL;
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const adsenseSlotId = import.meta.env.PUBLIC_ADSENSE_SLOT_ID;
const adsenseEnabled = import.meta.env.PROD && adsenseClientId && adsenseSlotId;
const gaMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const currentUser = Astro.locals.user;
---

<Layout title="Ludik Hub | Juegos de Ludik Studios" description="Descubre los juegos independientes de Ludik Studios." lang="es" adsenseClientId={adsenseEnabled ? adsenseClientId : undefined} gaMeasurementId={gaMeasurementId}>
	<main class="hub-shell">
		<header class="topbar">
			<a class="brand" href="#home" aria-label="Inicio de Ludik Hub" data-ga-event="home_brand">
				<span class="brand-card" aria-hidden="true">
					<span class="brand-card-corner">K<i>♦</i></span>
					<span class="brand-card-suit">♦</span>
					<span class="brand-card-corner brand-card-corner-bottom">K<i>♦</i></span>
				</span>
				<span>LUDIK <b>HUB</b></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="#games" data-ga-event="games_nav">Juegos</a>
				<a href="/donate/" data-ga-event="donate_nav">Apóyanos</a>
				{currentUser ? (
					<>
						{Astro.locals.isAdmin && <a href="/admin/">Administración</a>}
						<form class="nav-logout" method="POST" action="/api/auth/logout"><button type="submit">Cerrar sesión</button></form>
					</>
				) : (
					<>
						<a href="/login/">Iniciar sesión</a>
						<a href="/register/">Crear cuenta</a>
					</>
				)}
				<a href="/about/" data-ga-event="about_nav">Acerca de Ludik</a>
			</nav>
			<a class="studio-link" href="/about/" data-ga-event="studio_link">Un proyecto de Ludik Studios <span aria-hidden="true">↗</span></a>
		</header>

		<section class="feature" id="home" aria-label="Juego destacado">
			<div class="game-frame" aria-label="Juego de Unity Fortunato 21">
				<div class="game-interface">
					{unityGameUrl ? (
						<iframe
							class="unity-player"
							src={unityGameUrl}
							title="Fortunato 21"
							allow="autoplay; fullscreen; gamepad"
							allowfullscreen
						></iframe>
					) : (
						<div class="game-placeholder">
							<strong>La build WebGL de Unity aún no está configurada</strong>
							<span>PUBLIC_UNITY_GAME_URL con la URL del archivo index.html del juego alojado.</span>
						</div>
					)}
				</div>
				<div class="frame-cards" aria-hidden="true">
					<div class="frame-card frame-card-back"><span>Q</span><b>♠</b></div>
					<div class="frame-card frame-card-front"><span>J</span><b>♦</b></div>
				</div>
				<div class="frame-dice" aria-hidden="true">
					<div class="die die-five"><i></i><i></i><i></i><i></i><i></i></div>
					<div class="die die-four"><i></i><i></i><i></i><i></i></div>
				</div>
			</div>

			<aside class="game-info" aria-labelledby="game-title">
				<p class="eyebrow"><span></span> INFORMACIÓN DEL JUEGO</p>
				<h1 id="game-title">Fortunato<br /><em>21</em></h1>
				<p class="intro">Te damos la bienvenida a Ludik Hub. Fortunato 21 es nuestro juego de cartas inspirado en el espacio, creado por Ludik Studios.</p>
				<div class="feature-meta">
					<div><span class="meta-label">GÉNERO</span><strong>Juego de cartas</strong></div>
					<span class="coming-soon">UNITY WEBGL</span>
				</div>
				<a class="explore-link" href="#games" data-ga-event="explore_games">Explorar los juegos <span aria-hidden="true">↓</span></a>
			</aside>
		</section>

		{adsenseEnabled || import.meta.env.DEV ? (
			<AdSlot clientId={adsenseClientId} slotId={adsenseSlotId} />
		) : null}

		<section class="lower-row" id="games" aria-label="Novedades de juegos">
			<div class="update-note"><span class="update-icon" aria-hidden="true">✳</span><p><b>Un nuevo juego está tomando forma.</b><br />Pequeños mundos, creados con curiosidad por Ludik Studios.</p></div>
			<a id="about" class="about-link" href="mailto:hello@ludikstudios.com" data-ga-event="contact_email">Hecho con curiosidad <span aria-hidden="true">↗</span></a>
		</section>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) {
		min-width: 320px;
		min-height: 100vh;
		color: #19152e;
		position: relative;
		background-color: #07172d;
		background-image:
			radial-gradient(1px 1px at 7% 17%, rgba(224, 240, 255, .9) 99%, transparent),
			radial-gradient(1px 1px at 16% 73%, rgba(224, 240, 255, .75) 99%, transparent),
			radial-gradient(1px 1px at 25% 38%, rgba(224, 240, 255, .8) 99%, transparent),
			radial-gradient(1px 1px at 38% 84%, rgba(224, 240, 255, .8) 99%, transparent),
			radial-gradient(1px 1px at 49% 12%, rgba(224, 240, 255, .85) 99%, transparent),
			radial-gradient(1px 1px at 61% 56%, rgba(224, 240, 255, .75) 99%, transparent),
			radial-gradient(1px 1px at 72% 27%, rgba(224, 240, 255, .9) 99%, transparent),
			radial-gradient(1px 1px at 83% 78%, rgba(224, 240, 255, .8) 99%, transparent),
			radial-gradient(1px 1px at 94% 43%, rgba(224, 240, 255, .75) 99%, transparent),
			radial-gradient(ellipse at 50% 110%, rgba(22, 62, 111, .38), transparent 60%),
			linear-gradient(160deg, #061326 0%, #0a1b34 58%, #101a35 100%);
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
	}
	:global(body)::before,
	:global(body)::after {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	:global(body)::before {
		background-image:
			radial-gradient(2px 2px at 19% 31%, rgba(232, 246, 255, .9) 99%, transparent),
			radial-gradient(2px 2px at 43% 68%, rgba(232, 246, 255, .75) 99%, transparent),
			radial-gradient(2px 2px at 68% 19%, rgba(232, 246, 255, .85) 99%, transparent),
			radial-gradient(2px 2px at 88% 61%, rgba(232, 246, 255, .8) 99%, transparent);
		animation: star-glimmer 5s ease-in-out infinite alternate;
	}

	:global(body)::after {
		background-image:
			radial-gradient(3px 3px at 31% 48%, rgba(145, 205, 255, .42), transparent 70%),
			radial-gradient(3px 3px at 78% 87%, rgba(145, 205, 255, .36), transparent 70%),
			radial-gradient(2px 2px at 93% 12%, rgba(145, 205, 255, .48), transparent 70%);
		animation: star-glimmer 7s ease-in-out infinite alternate-reverse;
	}

	.hub-shell {
		position: relative;
		z-index: 1;
		width: min(1440px, 100%);
		min-height: 100vh;
		margin-inline: auto;
		padding: 26px 20px 22px;
		display: flex;
		flex-direction: column;
	}

	.topbar
	{ min-height: 52px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		color: #fff;
	}

	.brand
	{display: inline-flex;
		align-items: center;
		gap: 11px;
		color: inherit;
		font-size: 15px;
		font-weight: 800;
		letter-spacing: 1.5px;
		text-decoration: none;
	}

	.brand b
	{
		color: #ffcb76; 
	}

	.brand-card
	{ width: 31px;
		height: 41px;
		position: relative;
		flex: 0 0 auto;
		display: inline-block;
		border: 1px solid rgba(255,255,255,.9);
		border-radius: 4px;
		background: #fffaf1;
		box-shadow: 0 3px 10px rgba(0,0,0,.2);
		transform: rotate(-8deg); 

		animation: rotarCarta 4s ease-in-out infinite alternate;
	}

	@keyframes rotarCarta {
		0%{
			transform: rotate(calc(-15deg - 5deg)) TranslateY(0);
		}
		50%{
			transform: rotate(-15deg) translateY(-10px);
		}
		100%{
			transform: rotate(calc(-15deg + 5deg)) TranslateY(0);
		}
		
	}

	.brand-card-corner
	{ position: absolute; 
		top: 4px; left: 4px; 
		display: grid; justify-items: center; 
		color: #25314a; 
		font: 700 9px/.85 Georgia, 'Times New Roman', serif; 
	}

	.brand-card-corner i
	{ color: #d94c60;
		font: normal 8px/.9 Georgia, 'Times New Roman', serif; 
	}

	.brand-card-suit 
	{ position: absolute; 
		top: 50%; left: 50%; 
		color: #d94c60; 
		font-size: 18px; 
		line-height: 1; 
		transform: translate(-50%, -50%); 
	}

	.brand-card-corner-bottom 
	{ top: auto; 
		left: auto; 
		right: 4px; 
		bottom: 4px; 
		transform: rotate(180deg); 
	}

	nav 
	{ display: flex;
		gap: clamp(18px, 3vw, 42px); 
	}

	nav a, .studio-link, .about-link 
	{ color: inherit; 
		font-size: 13px; 
		font-weight: 700; 
		text-decoration: none; 
	}

	nav a 
	{
	 opacity: .9; 
	}

	nav a:hover, .studio-link:hover, .about-link:hover 
	{ text-decoration: underline; 
		text-underline-offset: 4px; 
	}

	.studio-link span, .about-link span 
	{ 
		margin-left: 5px; 
	}


	.feature {
		width: 100%;
		max-width: 1120px;
		margin: 44px auto 32px;
		display: grid;
		grid-template-columns: 1fr;
		gap: 18px;
		animation: arrive 700ms cubic-bezier(.2,.75,.25,1) both;
	}

	.game-frame {
		width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 360px;
		position: relative;
		border: 2px solid #d8eaff;
		background-color: #102b60;
		background-image:
			radial-gradient(circle, rgba(255,255,255,.82) 1px, transparent 1.5px),
			repeating-linear-gradient(0deg, transparent 0 23px, rgba(143,195,255,.08) 24px 25px),
			repeating-linear-gradient(90deg, transparent 0 23px, rgba(143,195,255,.08) 24px 25px),
			linear-gradient(135deg, #102d68, #07162f);
		background-size: 41px 37px, auto, auto, auto;
		isolation: isolate;
	}
	.game-frame::before { content: ''; position: absolute; inset: 7px; z-index: 2; border: 1px solid rgba(196,224,255,.45); pointer-events: none; }
	.game-interface { position: absolute; inset: 30px 32px; overflow: hidden; border: 2px solid #07152b; background: #080d17; }
	.unity-player { width: 100%; height: 100%; position: absolute; inset: 0; border: 0; background: #080d17; }
	.game-placeholder { position: absolute; inset: 0; padding: 24px; display: grid; align-content: center; justify-items: center; gap: 10px; color: rgba(255,255,255,.84); text-align: center; font-family: 'Courier New', monospace; }
	.game-placeholder strong { color: #fff; font-family: 'Arial Black', Impact, sans-serif; font-size: 17px; }
	.game-placeholder span { max-width: 440px; font-size: 13px; line-height: 1.5; }
	.frame-cards { position: absolute; z-index: 3; left: 4%; bottom: 2px; width: 132px; height: 104px; pointer-events: none; }
	.frame-card { width: 52px; height: 76px; position: absolute; border: 2px solid #fff9e9; background: #fff9e9; box-shadow: 3px 4px 0 #091a38; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 5px; color: #10254b; font: 800 14px/1 Georgia, serif; }
	.frame-card b { font-size: 24px; line-height: 1; }
	.frame-card-back { left: 8px; bottom: 5px; transform: rotate(-13deg); }
	.frame-card-front { left: 52px; bottom: 8px; color: #c9414b; transform: rotate(8deg); }
	.frame-dice { width: 94px; height: 66px; position: absolute; z-index: 3; top: 4px; right: 4%; transform: rotate(-7deg); pointer-events: none; }
	.die { width: 43px; height: 43px; position: absolute; padding: 6px; border: 2px solid #fff; border-radius: 9px; background: #eaf4ff; box-shadow: 3px 4px 0 #091a38; display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); align-items: center; justify-items: center; }
	.die-five { top: 0; right: 0; z-index: 2; transform: rotate(10deg); }
	.die-four { top: 17px; left: 0; z-index: 1; transform: rotate(-10deg); }
	.die i { width: 5px; height: 5px; border-radius: 50%; background: #14315d; }
	.die-four i { background: #d8474d; }
	.die-five i:nth-child(1) { grid-area: 1 / 1; }
	.die-five i:nth-child(2) { grid-area: 1 / 3; }
	.die-five i:nth-child(3) { grid-area: 2 / 2; }
	.die-five i:nth-child(4) { grid-area: 3 / 1; }
	.die-five i:nth-child(5) { grid-area: 3 / 3; }
	.die-four i:nth-child(1) { grid-area: 1 / 1; }
	.die-four i:nth-child(2) { grid-area: 1 / 3; }
	.die-four i:nth-child(3) { grid-area: 3 / 1; }
	.die-four i:nth-child(4) { grid-area: 3 / 3; }

	.game-info { min-height: 280px; padding: clamp(28px, 4vw, 56px); border: 1px solid rgba(224, 225, 255, .46); border-radius: 8px; background: rgba(39, 69, 177, .64); box-shadow: 0 22px 60px rgba(4, 11, 35, .28); color: #fff; display: flex; flex-direction: column; justify-content: center; font-family: 'Courier New', monospace; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
	.game-info .eyebrow, .game-info .meta-label { color: #fff; font-family: 'Arial Black', Impact, sans-serif; font-size: 10px; font-weight: 900; letter-spacing: 1.5px; }
	.game-info .eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 22px; }
	.game-info .eyebrow span { width: 9px; height: 9px; border: 2px solid #fff; border-radius: 0; background: #b08be2; transform: rotate(45deg); }
	.game-info h1 { margin: 0; color: #55366f; font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(48px, 5.7vw, 76px); font-weight: 900; line-height: .88; text-transform: uppercase; -webkit-text-stroke: 1px #eee4ff; paint-order: stroke fill; }
	.game-info h1 em { color: #55366f; font-style: normal; font-weight: 900; }
	.game-info .intro { max-width: 405px; margin: 23px 0 30px; color: #fff; font-family: 'Courier New', monospace; font-size: 14px; font-weight: 700; line-height: 1.65; }
	.game-info .feature-meta { max-width: 400px; padding: 16px 0; border-top: 2px dashed rgba(255,255,255,.72); border-bottom: 2px dashed rgba(255,255,255,.72); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
	.game-info .feature-meta div { display: grid; gap: 6px; }
	.game-info .meta-label { color: rgba(255,255,255,.78); font-size: 9px; }
	.game-info .feature-meta strong { color: #fff; font-family: 'Arial Black', Impact, sans-serif; font-size: 16px; font-weight: 900; }
	.game-info .coming-soon { padding: 7px 9px; border: 1px solid rgba(255,255,255,.52); border-radius: 3px; background: #4e3473; color: #fff; font-family: 'Arial Black', Impact, sans-serif; font-size: 9px; font-weight: 900; letter-spacing: 1px; white-space: nowrap; }
	.game-info .explore-link { width: fit-content; margin-top: 23px; padding: 8px 10px 8px 13px; border: 1px solid rgba(255,255,255,.62); border-radius: 3px; background: #4e3473; color: #fff; display: inline-flex; align-items: center; gap: 14px; font-family: 'Arial Black', Impact, sans-serif; font-size: 12px; font-weight: 900; text-decoration: none; text-transform: uppercase; }
	.game-info .explore-link span { width: 26px; height: 26px; border: 1px solid rgba(255,255,255,.62); border-radius: 2px; background: rgba(255,255,255,.12); color: #fff; display: grid; place-items: center; transition: transform 180ms ease; }
	.explore-link:hover span { transform: translateY(3px); }

	.lower-row { min-height: 66px; display: flex; align-items: end; justify-content: space-between; gap: 20px; color: white; }
	.update-note { display: flex; align-items: center; gap: 12px; }
	.update-icon { width: 31px; height: 31px; border: 1px solid rgba(255,255,255,.6); border-radius: 50%; display: grid; place-items: center; color: #fff2c1; font-size: 18px; }
	.update-note p { margin: 0; color: rgba(255,255,255,.82); font-size: 11px; line-height: 1.55; }
	.update-note b { color: white; font-size: 12px; }

	@keyframes arrive { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes star-glimmer { from { opacity: .22; } to { opacity: .82; } }
	@media (max-width: 760px) {
		.hub-shell { min-height: 100svh; padding: 18px 20px; }
		.topbar { flex-wrap: wrap; gap: 12px; }
		nav { order: 3; width: 100%; padding: 8px 0 2px; }
		.studio-link { font-size: 11px; }
		.feature { margin: 28px 0 22px; gap: 14px; }
		.game-frame { height: clamp(300px, 80vw, 420px); min-height: 0; aspect-ratio: auto; }
		.game-interface { inset: 22px; }
		.frame-cards { transform: scale(.8); transform-origin: bottom left; }
		.frame-dice { transform: scale(.82) rotate(-7deg); transform-origin: top right; }
		.game-info { padding: 28px 24px; }
		h1 { font-size: clamp(54px, 12vw, 76px); }
		.intro { margin: 18px 0 22px; }
		.lower-row { min-height: 52px; align-items: center; }
	}
	@media (max-width: 420px) {
		.hub-shell { padding-inline: 20px; }
		.studio-link { max-width: 130px; text-align: right; }
		.coming-soon { font-size: 8px; }
		.about-link { font-size: 11px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.feature { animation: none; }
		.explore-link span { transition: none; }
		:global(body)::before, :global(body)::after { animation: none; }
	}
</style>

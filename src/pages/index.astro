---
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';

const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const adsenseEnabled = import.meta.env.PROD && adsenseClientId;    
const gaMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const currentUser = Astro.locals.user;

// Lista de juegos
const games = [
	{
		id: '21-fortunato',
		title: '21 Fortunato',
		subtitle: 'Juego de cartas espacial',
		genre: 'Cartas / Estrategia',
		platform: 'UNITY WEBGL',
		status: 'DISPONIBLE',
		description: 'Te damos la bienvenida a Ludik Hub. Fortunato 21 es nuestro juego de cartas inspirado en el espacio, creado por Ludik Studios.',
		gameUrl: '/game/build/21-fortunato/index.html',
		detailUrl: '/games/fortunato-21',
		thumbnail: '♦',
		active: true
	},
	{
		id: 'coretaker',
		title: 'Coretaker',
		subtitle: 'Acción y supervivencia táctica',
		genre: 'Acción / Supervivencia',
		platform: 'UNITY WEBGL',
		status: 'DISPONIBLE',
		description: 'Protege el núcleo energético y sobrevive a los desafíos espaciales en Coretaker, la nueva experiencia de acción desarrollada en Unity WebGL por Ludik Studios.',
		gameUrl: '/game/build/coretaker/index.html',
		detailUrl: '/games/coretaker',
		thumbnail: '⚡',
		active: false
	}
];

// Slots vacíos para el carrusel
const emptySlotsCount = 3;
---

<Layout title="Ludik Hub | Ludik Studios" description="Descubre y juega los títulos independientes de Ludik Studios." lang="es" adsenseClientId={adsenseEnabled ? adsenseClientId : undefined} gaMeasurementId={gaMeasurementId}>
	<main class="hub-shell">
		<!-- BARRA SUPERIOR -->
		<header class="topbar">
			<a class="brand" href="#home" aria-label="Inicio de Ludik Hub" data-ga-event="home_brand">
				<span class="brand-card" aria-hidden="true">
					<span class="brand-card-corner">K<i>♦</i></span>
					<span class="brand-card-suit">♦</span>
					<span class="brand-card-corner brand-card-corner-bottom">K<i>♦</i></span>
				</span>
				<span>LUDIK <b>HUB</b></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="/catalog/" data-ga-event="games_nav">Catálogo</a>
				<a href="/donate/" data-ga-event="donate_nav">Apóyanos</a>
				{currentUser ? (
					<>
						{Astro.locals.isAdmin && <a href="/admin/">Administración</a>}
						<form class="nav-logout" method="POST" action="/api/auth/logout"><button type="submit">Cerrar sesión</button></form>
					</>
				) : (
					<>
						<a href="/login/">Iniciar sesión</a>
						<a href="/register/">Crear cuenta</a>
					</>
				)}
				<a href="/about/" data-ga-event="about_nav">Acerca de Ludik</a>
			</nav>
			<a class="studio-link" href="/about/" data-ga-event="studio_link">Un proyecto de Ludik Studios <span aria-hidden="true">↗</span></a>
		</header>

		<!-- STAGE / HERO ESTILO DEEP SILVER -->
		<section class="ds-stage" id="home" aria-label="Juego destacado">
			<div class="stage-container">
				<!-- LADO IZQUIERDO: DETALLES DEL JUEGO SELECCIONADO -->
				<div class="stage-info">
					<div class="badge-status">
						<span class="pulse-dot"></span>
						<span>DESTACADO DE LUDIK</span>
					</div>
					<h1 class="game-title" id="hero-title">Fortunato <em>21</em></h1>
					<p class="game-genre" id="hero-genre">GÉNERO: <b>JUEGO DE CARTAS / ESPACIAL</b></p>
					<p class="game-description" id="hero-description">
						Desafía la suerte en el espacio. Un juego táctico de 21 cartas con mecánicas únicas de tienda y potenciadores desarrollado en Unity WebGL.
					</p>
					
					<div class="stage-actions">
						<button class="btn-primary" type="button" id="hero-play-btn">
							<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
							JUGAR AHORA
						</button>
						<!-- ENLACE A LA PÁGINA DE DESCRIPCIÓN DEL JUEGO -->
						<a href="/games/fortunato-21" class="btn-secondary" id="hero-detail-btn" data-ga-event="game_details">
							VER DETALLES
						</a>
					</div>
				</div>

				<!-- LADO DERECHO: FRAME INTERACTIVO CON PORTADA PREVIA -->
				<div class="stage-view">
					<div class="game-frame" id="games" aria-label="Juego de Unity Fortunato 21">
						
						<!-- CONTENEDOR DINÁMICO DEL JUEGO -->
						<div class="game-interface" id="game-interface">
							<!-- PORTADA DE INICIO (Se muestra por defecto hasta hacer clic) -->
							<!-- CONTENEDOR DEL IFRAME DE UNITY (Oculto hasta que cargue) -->
							<div class="game-player-wrapper hidden" id="game-player-wrapper"></div>
							<div class="game-poster" id="game-poster">
								<div class="poster-content">
									<span class="poster-icon" id="poster-icon">♦</span>
									<h3 id="poster-title">Fortunato 21</h3>
									<p id="poster-subtitle">Haz clic para cargar el juego en el navegador</p>
									<button class="btn-play-trigger" type="button" id="btn-start-game">
										<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
											<path d="M8 5v14l11-7z"/>
										</svg>
										Cargar Juego
									</button>
								</div>
							</div>
						</div>

						<!-- BOTÓN DE PANTALLA COMPLETA (Oculto hasta que cargue el juego) -->
						<button class="game-fullscreen-button hidden" type="button" data-game-fullscreen aria-pressed="false">
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<path d="M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m13-5v3a2 2 0 0 1-2 2h-3" />
							</svg>
							<span data-game-fullscreen-label>Pantalla completa</span>
						</button>
						<p class="game-fullscreen-status" data-game-fullscreen-status role="status" aria-live="polite"></p>
					</div>
				</div>
			</div>
		</section>

		<!-- CARRUSEL DE CATÁLOGO / SELECCIÓN DE JUEGOS -->
		<section class="ds-carousel-section" id="catalogo" aria-label="Catálogo de juegos">
			<div class="carousel-header">
				<h2>NUESTROS <span>JUEGOS</span></h2>
				<p>Selecciona un título para cargarlo en el escenario principal</p>
			</div>

			<div class="carousel-track-wrapper">
				<div class="carousel-track">
					<!-- JUEGO ACTUAL (FORTUNATO 21) -->
					{games.map((game) => (
						<article class={`game-card ${game.active ? 'active' : ''}`} data-game-id={game.id} role="button" tabindex="0">
							<div class="card-media">
								<div class="card-icon">{game.thumbnail}</div>
								<span class="card-badge">{game.status}</span>
							</div>
							<div class="card-body">
								<span class="card-platform">{game.platform}</span>
								<h3 class="card-title">{game.title}</h3>
								<p class="card-subtitle">{game.subtitle}</p>
							</div>
							<div class="card-glow"></div>
						</article>
					))}

					<!-- SLOTS VACÍOS / PRÓXIMAMENTE -->
					{Array.from({ length: emptySlotsCount }).map((_, i) => (
						<article class="game-card empty-slot">
							<div class="card-media empty-media">
								<div class="plus-icon">+</div>
								<span class="card-badge coming">EN DESARROLLO</span>
							</div>
							<div class="card-body">
								<span class="card-platform">LUDIK LABS</span>
								<h3 class="card-title">Próximamente #{i + 1}</h3>
								<p class="card-subtitle">Proyecto sin anunciar</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- PIE DE PÁGINA NOTAS -->
		<footer class="lower-row">
			<div class="update-note">
				<span class="update-icon" aria-hidden="true">✳</span>
				<p><b>Ludik Studios Hub</b><br />Experiencias indie hechas con curiosidad.</p>
			</div>
			<a class="about-link" href="mailto:hello@ludikstudios.com" data-ga-event="contact_email">Contacto & Prensa <span aria-hidden="true">↗</span></a>
		</footer>
	</main>
</Layout>

<script define:vars={{ initialGames: games }}>
	const gamePoster = document.getElementById('game-poster');
	const gamePlayerWrapper = document.getElementById('game-player-wrapper');
	const posterIcon = document.getElementById('poster-icon');
	const posterTitle = document.getElementById('poster-title');
	const startBtn = document.getElementById('btn-start-game');
	const heroPlayBtn = document.getElementById('hero-play-btn');
	const fullscreenBtn = document.querySelector('[data-game-fullscreen]');
	const fullscreenLabel = document.querySelector('[data-game-fullscreen-label]');
	const fullscreenStatus = document.querySelector('[data-game-fullscreen-status]');
	const gameFrame = document.querySelector('.game-frame');
	const fallbackClass = 'game-frame--fullscreen-fallback';

	const heroTitle = document.getElementById('hero-title');
	const heroGenre = document.getElementById('hero-genre');
	const heroDescription = document.getElementById('hero-description');
	const heroDetailBtn = document.getElementById('hero-detail-btn');

	let currentGame = initialGames[0];
	let gameLoaded = false;

	function loadCurrentGame() {
		if (!gamePlayerWrapper || !gamePoster) return;

		gamePlayerWrapper.innerHTML = `
			<iframe
				class="unity-player"
				src="${currentGame.gameUrl}"
				title="${currentGame.title}"
				allow="autoplay; fullscreen; gamepad"
				allowfullscreen
				style="width: 100%; height: 100%; border: 0; display: block;"
			></iframe>
		`;

		gamePoster.classList.add('hidden');
		gamePlayerWrapper.classList.remove('hidden');
		gameLoaded = true;

		if (fullscreenBtn) {
			fullscreenBtn.classList.remove('hidden');
		}

		document.getElementById('games')?.scrollIntoView({ behavior: 'smooth' });
	}

	function resetToPoster(game) {
		if (!gamePoster || !gamePlayerWrapper) return;

		// Si habÃ­a un juego corriendo, vaciamos el iframe para liberar recursos y audio
		gamePlayerWrapper.innerHTML = '';
		gamePlayerWrapper.classList.add('hidden');

		// Actualizamos los datos del poster manteniendo el mismo botÃ³n estilizado intacto
		if (posterIcon) posterIcon.textContent = game.thumbnail;
		if (posterTitle) posterTitle.textContent = game.title;

		gamePoster.classList.remove('hidden');
		gameLoaded = false;

		if (fullscreenBtn) {
			fullscreenBtn.classList.add('hidden');
		}
	}

	function selectGame(game) {
		currentGame = game;

		// Actualizar informaciÃ³n del Hero
		if (heroTitle) heroTitle.textContent = game.title;
		if (heroGenre) heroGenre.innerHTML = `GÉNERO: <b>${game.genre.toUpperCase()}</b>`;
		if (heroDescription) heroDescription.textContent = game.description;
		if (heroDetailBtn) heroDetailBtn.setAttribute('href', game.detailUrl);

		// Actualizar tarjeta activa en el carrusel
		document.querySelectorAll('.game-card[data-game-id]').forEach((card) => {
			if (card.getAttribute('data-game-id') === game.id) {
				card.classList.add('active');
			} else {
				card.classList.remove('active');
			}
		});

		// Mostrar la portada con el botÃ³n "Cargar Juego" para el juego seleccionado
		resetToPoster(game);
	}

	startBtn?.addEventListener('click', loadCurrentGame);
	heroPlayBtn?.addEventListener('click', loadCurrentGame);

	document.querySelectorAll('.game-card[data-game-id]').forEach((card) => {
		card.addEventListener('click', () => {
			const id = card.getAttribute('data-game-id');
			const selected = initialGames.find((g) => g.id === id);
			if (selected) selectGame(selected);
		});
		card.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				const id = card.getAttribute('data-game-id');
				const selected = initialGames.find((g) => g.id === id);
				if (selected) selectGame(selected);
			}
		});
	});

	// LÃ³gica de pantalla completa
	if (
		gameFrame instanceof HTMLElement &&
		fullscreenBtn instanceof HTMLButtonElement &&
		fullscreenLabel instanceof HTMLSpanElement &&
		fullscreenStatus instanceof HTMLParagraphElement
	) {
		const updateFullscreenButton = () => {
			const isFullscreen =
				document.fullscreenElement === gameFrame || gameFrame.classList.contains(fallbackClass);
			fullscreenLabel.textContent = isFullscreen
				? 'Salir de pantalla completa'
				: 'Pantalla completa';
			fullscreenBtn.setAttribute('aria-pressed', String(isFullscreen));
		};

		document.addEventListener('fullscreenchange', updateFullscreenButton);
		fullscreenBtn.addEventListener('click', async () => {
			if (gameFrame.classList.contains(fallbackClass)) {
				gameFrame.classList.remove(fallbackClass);
				document.documentElement.classList.remove(fallbackClass);
				fullscreenStatus.textContent = '';
				updateFullscreenButton();
				return;
			}

			if (document.fullscreenElement === gameFrame) {
				await document.exitFullscreen();
				return;
			}

			try {
				if (typeof gameFrame.requestFullscreen !== 'function') {
					throw new Error('Fullscreen API unavailable');
				}
				await gameFrame.requestFullscreen();
				fullscreenStatus.textContent = '';
			} catch {
				gameFrame.classList.add(fallbackClass);
				document.documentElement.classList.add(fallbackClass);
				fullscreenStatus.textContent =
					'Navegador sin modo inmersivo; expandiendo a pantalla completa.';
				updateFullscreenButton();
			}
		});
	}
</script>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) {
		min-width: 320px;
		min-height: 100vh;
		color: #fff;
		position: relative;
		background-color: #050b14;
		background-image:
			radial-gradient(ellipse at 50% 0%, rgba(26, 54, 110, 0.45), transparent 70%),
			linear-gradient(180deg, #050b14 0%, #091325 100%);
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
	}

	.hub-shell {
		position: relative;
		z-index: 1;
		width: min(1440px, 100%);
		min-height: 100vh;
		margin-inline: auto;
		padding: 24px 24px 32px;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	/* TOPBAR */
	.topbar {
		min-height: 52px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		padding-bottom: 16px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		color: inherit;
		font-size: 16px;
		font-weight: 800;
		letter-spacing: 1.5px;
		text-decoration: none;
	}
	.brand b { color: #ffcb76; }
	.brand-card {
		width: 28px;
		height: 38px;
		position: relative;
		border: 1px solid rgba(255,255,255,.9);
		border-radius: 4px;
		background: #fffaf1;
		box-shadow: 0 3px 10px rgba(0,0,0,.4);
		transform: rotate(-8deg); 
		animation: rotarCarta 4s ease-in-out infinite alternate;
	}
	@keyframes rotarCarta {
		0%{ transform: rotate(-15deg) translateY(0); }
		100%{ transform: rotate(-5deg) translateY(-6px); }
	}
	.brand-card-corner {
		position: absolute; top: 3px; left: 3px; 
		color: #25314a; font: 700 8px/.85 Georgia, serif; 
	}
	.brand-card-corner i { color: #d94c60; font-style: normal; }
	.brand-card-suit {
		position: absolute; top: 50%; left: 50%; 
		color: #d94c60; font-size: 16px; transform: translate(-50%, -50%); 
	}
	.brand-card-corner-bottom { top: auto; left: auto; right: 3px; bottom: 3px; transform: rotate(180deg); }

	nav { display: flex; gap: clamp(16px, 2.5vw, 36px); }
	nav a, .studio-link, .about-link {
		color: rgba(255,255,255,.85); font-size: 13px; font-weight: 700; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;
	}
	nav a:hover, .studio-link:hover, .about-link:hover { color: #ffcb76; }

	/* DEEP SILVER STAGE (HERO) */
	.ds-stage {
		width: 100%;
		border-radius: 12px;
		background: rgba(14, 27, 52, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(12px);
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
		overflow: hidden;
	}
	.stage-container {
		display: grid;
		grid-template-columns: 1fr 1.3fr;
		gap: 24px;
		padding: 36px;
		align-items: center;
	}
	.stage-info {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.badge-status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		border-radius: 20px;
		background: rgba(255, 203, 118, 0.12);
		border: 1px solid rgba(255, 203, 118, 0.4);
		color: #ffcb76;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 1.5px;
		width: fit-content;
	}
	.pulse-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #ffcb76;
		box-shadow: 0 0 10px #ffcb76;
		animation: pulse 2s infinite;
	}
	@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

	.game-title {
		margin: 0;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: clamp(48px, 5vw, 76px);
		line-height: 0.95;
		text-transform: uppercase;
		color: #fff;
		letter-spacing: 1px;
	}
	.game-title em { color: #ffcb76; font-style: normal; }
	.game-genre {
		margin: 0;
		font-size: 11px;
		letter-spacing: 1.5px;
		color: rgba(255, 255, 255, 0.6);
	}
	.game-genre b { color: #fff; }
	.game-description {
		margin: 8px 0 16px;
		font-size: 15px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.85);
		max-width: 480px;
	}
	.stage-actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}
	.btn-primary {
		padding: 14px 28px;
		border: none;
		border-radius: 6px;
		background: linear-gradient(135deg, #ffcb76 0%, #e5a438 100%);
		color: #071325;
		font-family: 'Arial Black', Impact, sans-serif;
		font-size: 13px;
		letter-spacing: 1px;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		box-shadow: 0 8px 24px rgba(255, 203, 118, 0.3);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 30px rgba(255, 203, 118, 0.45);
	}

	/* ESTILOS DEL BOTÓN / ENLACE VER DETALLES */
	.btn-secondary {
		padding: 14px 24px;
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #fff;
		font-family: 'Arial Black', Impact, sans-serif;
		font-size: 13px;
		letter-spacing: 1px;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background 0.2s ease, border-color 0.2s ease;
	}
	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.35);
		color: #fff;
	}

	/* STAGE GAME FRAME */
	.stage-view { width: 100%; }
	.game-frame {
		width: 100%;
		aspect-ratio: 16 / 10;
		position: relative;
		border-radius: 8px;
		border: 2px solid rgba(255, 255, 255, 0.2);
		background: #000;
		overflow: hidden;
		box-shadow: 0 16px 40px rgba(0,0,0,0.7);
	}
	.game-interface { position: absolute; inset: 0; }
	.game-player-wrapper {
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
	}
	.game-player-wrapper.hidden,
	.game-poster.hidden {
		display: none !important;
	}
	.game-player-wrapper :global(.unity-player),
	.game-player-wrapper :global(iframe),
	.game-interface :global(.unity-player),
	.game-interface :global(iframe),
	.unity-player {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	/* PORTADA DE INICIO DEL JUEGO */
	.game-poster,
	.game-interface :global(.game-poster) {
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(circle at center, #183366 0%, #081020 100%);
		text-align: center;
		padding: 20px;
	}
	.poster-content,
	.game-interface :global(.poster-content) {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}
	.poster-icon,
	.game-interface :global(.poster-icon) {
		font-size: 54px;
		color: #d94c60;
		text-shadow: 0 0 24px rgba(217, 76, 96, 0.6);
	}
	.poster-content h3,
	.game-interface :global(.poster-content h3) {
		margin: 0;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: 28px;
		color: #fff;
		letter-spacing: 1px;
	}
	.poster-content p,
	.game-interface :global(.poster-content p) {
		margin: 0 0 8px;
		font-size: 13px;
		color: rgba(255, 255, 255, 0.7);
	}
	.btn-play-trigger,
	.game-interface :global(.btn-play-trigger) {
		padding: 12px 24px;
		border: none;
		border-radius: 6px;
		background: #ffcb76;
		color: #071325;

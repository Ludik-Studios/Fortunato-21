---
import Layout from '../../layouts/Layout.astro';
import GameReviews from '../../components/GameReviews.astro';
import { getEntry } from 'astro:content';

const { id } = Astro.params;
if (!id) return Astro.redirect('/catalog');

const projectEntry = await getEntry('projects', id);
if (!projectEntry) {
	return Astro.redirect('/catalog');
}

const project = {
	id: projectEntry.id,
	...projectEntry.data
};

const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const adsenseEnabled = import.meta.env.PROD && adsenseClientId;
const gaMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
---

<Layout
	title={`${project.title} | Ludik Studios`}
	description={`${project.title}: ${project.tagline}. ${project.description}`}
	lang="es"
	adsenseClientId={adsenseEnabled ? adsenseClientId : undefined}
	gaMeasurementId={gaMeasurementId}
>
	<main class="project-detail-shell">
		<!-- BARRA SUPERIOR -->
		<header class="topbar">
			<a class="brand" href="/" aria-label="Inicio de Ludik Hub">
				<span class="brand-card" aria-hidden="true">
					<span class="brand-card-corner">K<i>♦</i></span>
					<span class="brand-card-suit">♦</span>
					<span class="brand-card-corner brand-card-corner-bottom">K<i>♦</i></span>
				</span>
				<span>LUDIK <b>HUB</b></span>
			</a>
			<nav aria-label="Navegación principal">
				<a href="/">Inicio</a>
				<a href="/catalog/">Catálogo</a>
				<a href="/donate/">Apóyanos</a>
				<a href="/about/">Acerca de Ludik</a>
			</nav>
			<a class="back-link" href="/catalog/">← Volver al Catálogo</a>
		</header>

		<!-- CONTENIDO PRINCIPAL -->
		<article class="project-container">
			<header class="detail-header">
				<div class="header-badges">
					<span class="badge-category">{project.category}</span>
					<span class="badge-year">{project.year}</span>
					<span class={`badge-status status-${project.status.toLowerCase()}`}>{project.status}</span>
				</div>
				<h1>{project.title}</h1>
				<p class="tagline">{project.tagline}</p>
			</header>

			<div class="content-grid">
				<!-- SECCIÓN PRINCIPAL: DESCRIPCIÓN Y MULTIMEDIA -->
				<div class="main-column">
					<section class="section-card">
						<h2>Sobre el Proyecto</h2>
						<p class="description-text">{project.description}</p>
					</section>

					<!-- MULTIMEDIA -->
					<section class="section-card">
						<div class="card-header-row">
							<h2>Galería & Multimedia</h2>
							<small class="hint">Trailer, demostraciones y capturas</small>
						</div>

						<div class="media-layout">
							<!-- VIDEO -->
							<div class="media-video-wrapper">
								{project.media?.videoUrl ? (
									project.media.videoUrl.includes('youtube.com') || project.media.videoUrl.includes('youtu.be') ? (
										<iframe src={project.media.videoUrl} title={`Video ${project.title}`} allowfullscreen class="media-frame"></iframe>
									) : (
										<video src={project.media.videoUrl} controls class="media-frame"></video>
									)
								) : (
									<div class="media-empty-placeholder">
										<svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor">
											<path d="M8 5v14l11-7z"/>
										</svg>
										<strong>Trailer o Demostración</strong>
										<span>Espacio reservado para video oficial</span>
									</div>
								)}
							</div>

							<!-- FOTOS -->
							<div class="media-photos-grid">
								{project.media?.gallery && project.media.gallery.length > 0 ? (
									project.media.gallery.map((img, i) => (
										<div class="photo-item">
											<img src={img} alt={`Captura ${i + 1} de ${project.title}`} />
										</div>
									))
								) : (
									<>
										<div class="photo-placeholder">
											<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
												<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
												<circle cx="8.5" cy="8.5" r="1.5"/>
												<polyline points="21 15 16 10 5 21"/>
											</svg>
											<span>Captura 1</span>
										</div>
										<div class="photo-placeholder">
											<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
												<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
												<circle cx="8.5" cy="8.5" r="1.5"/>
												<polyline points="21 15 16 10 5 21"/>
											</svg>
											<span>Captura 2</span>
										</div>
									</>
								)}
							</div>
						</div>
					</section>

					<!-- COMENTARIOS Y VALORACIONES -->
					<GameReviews gameId={project.id} gameTitle={project.title} />
				</div>

				<!-- BARRA LATERAL: EQUIPO Y ENLACES -->
				<aside class="sidebar-column">
					{(project.playUrl || project.externalUrl) && (
						<div class="sidebar-card action-card">
							<h3>Enlaces del Proyecto</h3>
							<div class="actions-group">
								{project.playUrl && (
									<a href={project.playUrl} class="btn-primary">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
										{project.categorySlug === 'videojuegos' ? 'Jugar Ahora' : 'Probar Plataforma'}
									</a>
								)}
								{project.externalUrl && (
									<a href={project.externalUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
										Visitar Enlace Externo ↗
									</a>
								)}
							</div>
						</div>
					)}

					<div class="sidebar-card">
						<h3>Equipo Involucrado</h3>
						<ul class="team-list">
							{project.team.map((member) => (
								<li class="team-member">
									<span class="role">{member.role}</span>
									<strong class="name">{member.name}</strong>
									{member.contact && (
										<a href={`mailto:${member.contact}`} class="contact">
											{member.contact}
										</a>
									)}
								</li>
							))}
						</ul>
					</div>
				</aside>
			</div>
		</article>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) {
		margin: 0;
		background: #050b14;
		color: #fff;
		font-family: system-ui, -apple-system, sans-serif;
	}

	.project-detail-shell {
		max-width: 1200px;
		margin: 0 auto;
		padding: 24px 20px 80px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding-bottom: 24px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		margin-bottom: 36px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: #fff;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: 20px;
	}
	.brand b { color: #ffcb76; }
	.brand-card {
		width: 28px;
		height: 38px;
		border-radius: 4px;
		background: #fff;
		color: #c92a2a;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2px 3px;
		font-size: 10px;
		font-weight: 900;
	}
	.brand-card-suit { font-size: 14px; text-align: center; }
	.brand-card-corner-bottom { transform: rotate(180deg); }

	.topbar nav {
		display: flex;
		gap: 16px;
	}
	.topbar nav a {
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
		font-size: 14px;
		font-weight: 600;
	}
	.topbar nav a:hover { color: #ffcb76; }
	.back-link {
		color: #ffcb76;
		text-decoration: none;
		font-size: 13px;
		font-weight: 700;
	}

	.detail-header {
		margin-bottom: 36px;
	}
	.header-badges {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}
	.badge-category {
		background: rgba(255, 203, 118, 0.15);
		color: #ffcb76;
		border: 1px solid rgba(255, 203, 118, 0.4);
		padding: 4px 12px;
		border-radius: 20px;
		font-size: 11px;
		font-weight: 800;
		text-transform: uppercase;
	}
	.badge-year {
		color: rgba(255, 255, 255, 0.6);
		font-size: 13px;
		font-weight: 700;
	}
	.badge-status {
		padding: 4px 10px;
		border-radius: 4px;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.5px;
		background: rgba(255, 255, 255, 0.1);
	}
	.status-disponible { background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.4); }
	.status-activo { background: rgba(56, 189, 248, 0.2); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); }

	.detail-header h1 {
		margin: 0 0 10px;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: clamp(32px, 5vw, 48px);
		letter-spacing: 1px;
	}
	.tagline {
		margin: 0;
		font-size: 18px;
		color: rgba(255, 255, 255, 0.75);
	}

	.content-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 32px;
	}

	.section-card {
		background: rgba(14, 27, 52, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		padding: 28px;
		margin-bottom: 28px;
	}
	.section-card h2 {
		margin: 0 0 16px;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: 22px;
		letter-spacing: 0.5px;
	}
	.card-header-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 16px;
	}
	.card-header-row h2 { margin: 0; }
	.hint { color: rgba(255, 255, 255, 0.5); font-size: 12px; }

	.description-text {
		margin: 0;
		font-size: 16px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.85);
	}

	.media-layout {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.media-video-wrapper {
		aspect-ratio: 16 / 9;
		background: rgba(5, 11, 20, 0.8);
		border-radius: 8px;
		overflow: hidden;
		border: 1px dashed rgba(255, 255, 255, 0.15);
	}
	.media-frame {
		width: 100%;
		height: 100%;
		border: none;
		object-fit: cover;
	}
	.media-empty-placeholder {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		color: rgba(255, 255, 255, 0.4);
	}
	.media-empty-placeholder strong { color: rgba(255, 255, 255, 0.7); }

	.media-photos-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
	}
	.photo-placeholder {
		aspect-ratio: 16 / 9;
		background: rgba(5, 11, 20, 0.5);
		border: 1px dashed rgba(255, 255, 255, 0.15);
		border-radius: 6px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 6px;
		color: rgba(255, 255, 255, 0.4);
		font-size: 12px;
	}
	.photo-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 6px;
	}

	.sidebar-column {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.sidebar-card {
		background: rgba(14, 27, 52, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		padding: 24px;
	}
	.sidebar-card h3 {
		margin: 0 0 16px;
		font-family: Impact, 'Arial Black', sans-serif;
		font-size: 18px;
		letter-spacing: 0.5px;
	}
	.actions-group {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.btn-primary, .btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 12px 18px;
		border-radius: 6px;
		font-weight: 700;
		font-size: 13px;
		text-decoration: none;
	}
	.btn-primary {
		background: #ffcb76;
		color: #050b14;
	}
	.btn-secondary {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.team-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.team-member {
		display: flex;
		flex-direction: column;
		gap: 2px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		padding-bottom: 12px;
	}
	.team-member:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}
	.team-member .role {
		font-size: 10px;
		font-weight: 800;
		color: #ffcb76;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}
	.team-member .name {
		font-size: 14px;
		color: #fff;
	}
	.team-member .contact {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		text-decoration: none;
	}
	.team-member .contact:hover { color: #ffcb76; }

	@media (max-width: 860px) {
		.content-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

---
interface Props {
	mode: 'login' | 'register';
}

const { mode } = Astro.props;
const isRegister = mode === 'register';
---

<form class="auth-form" data-auth-form data-mode={mode}>
	<label for="email">Correo electrónico</label>
	<input id="email" name="email" type="email" autocomplete="email" required />

	<label for="password">Contraseña</label>
	<input id="password" name="password" type="password" autocomplete={isRegister ? 'new-password' : 'current-password'} minlength="8" required />

	{isRegister && (
		<>
			<label for="confirm-password">Confirmar contraseña</label>
			<input id="confirm-password" name="confirm-password" type="password" autocomplete="new-password" minlength="8" required />
		</>
	)}

	<button type="submit">{isRegister ? 'Crear cuenta' : 'Iniciar sesión'}</button>
	<p class="auth-status" data-auth-status role="status" aria-live="polite"></p>
</form>

<script>
	import { createBrowserClient } from '@supabase/ssr';

	const form = document.querySelector<HTMLFormElement>('[data-auth-form]');
	const status = document.querySelector<HTMLElement>('[data-auth-status]');
	const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
	const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

	if (form && status && submit) {
		if (!supabaseUrl || !supabaseKey) {
			status.textContent = 'El servicio de cuentas aún no está configurado.';
			submit.disabled = true;
		} else {
			const supabase = createBrowserClient(supabaseUrl, supabaseKey);
			const authError = new URLSearchParams(window.location.search).get('error');

			if (authError === 'confirmation') {
				status.textContent = 'No se pudo confirmar el correo. Solicita un nuevo enlace o vuelve a iniciar sesión.';
			}

			const redirectAfterAuth = () => {
				const next = new URLSearchParams(window.location.search).get('next');
				if (!next?.startsWith('/') || next.startsWith('//')) {
					window.location.assign('/');
					return;
				}

				try {
					const target = new URL(next, window.location.origin);
					window.location.assign(target.origin === window.location.origin ? target.href : '/');
				} catch {
					window.location.assign('/');
				}
			};

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				status.textContent = '';
				submit.disabled = true;

				const formData = new FormData(form);
				const email = String(formData.get('email')).trim();
				const password = String(formData.get('password'));

				try {
					if (form.dataset.mode === 'register') {
						const confirmation = String(formData.get('confirm-password'));
						if (password !== confirmation) {
							status.textContent = 'Las contraseñas no coinciden.';
							return;
						}

						const { data, error } = await supabase.auth.signUp({
							email,
							password,
							options: { emailRedirectTo: `${window.location.origin}/auth/callback` },
						});
						if (error) {
							const errorCode = error.code?.toLowerCase() ?? '';
							const errorMessage = error.message.toLowerCase();

							if (errorCode === 'user_already_exists' || errorMessage.includes('already registered')) {
								status.textContent = 'Ya existe una cuenta con ese correo. Inicia sesión en su lugar.';
							} else if (errorCode === 'email_address_invalid' || errorMessage.includes('invalid email')) {
								status.textContent = 'El correo electrónico no es válido. Revísalo e inténtalo de nuevo.';
							} else if (errorCode === 'weak_password' || errorMessage.includes('password should')) {
								status.textContent = `La contraseña no cumple los requisitos: ${error.message}`;
							} else if (errorCode === 'over_email_send_rate_limit' || errorMessage.includes('rate limit')) {
								status.textContent = 'Se solicitaron demasiados correos en poco tiempo. Espera unos minutos e inténtalo de nuevo.';
							} else if (errorCode === 'signup_disabled' || errorMessage.includes('signups not allowed')) {
								status.textContent = 'El registro está deshabilitado en Supabase. Activa los registros por correo en la configuración de Auth.';
							} else {
								status.textContent = `Supabase rechazó el registro: ${error.message}`;
							}
							return;
						}
						if (data.session) {
							redirectAfterAuth();
							return;
						}
						status.textContent = 'Revisa tu correo para confirmar la dirección y terminar de crear la cuenta.';
						return;
					}

					const { error } = await supabase.auth.signInWithPassword({ email, password });
					if (error) {
						status.textContent = 'No se pudo iniciar sesión. Verifica el correo y la contraseña.';
						return;
					}

					redirectAfterAuth();
				} catch {
					status.textContent = 'No fue posible conectar con el servicio de cuentas. Inténtalo de nuevo.';
				} finally {
					submit.disabled = false;
				}
			});
		}
	}
</script>

<style>
	.auth-form { display: grid; gap: 10px; }
	.auth-form label { margin-top: 8px; color: #d7def1; font: 700 11px 'Courier New', monospace; letter-spacing: .7px; }
	.auth-form input { width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid rgba(218,231,255,.32); border-radius: 2px; outline: none; background: rgba(4,13,30,.72); color: #fff; font: 15px 'Courier New', monospace; }
	.auth-form input:focus { border-color: #ffcf67; box-shadow: 0 0 0 2px rgba(255,207,103,.15); }
	.auth-form button { min-height: 46px; margin-top: 10px; border: 1px solid #ffcf67; border-radius: 2px; background: #ffcf67; color: #17203a; cursor: pointer; font: 900 12px 'Arial Black', Impact, sans-serif; text-transform: uppercase; }
	.auth-form button:disabled { cursor: not-allowed; opacity: .56; }
	.auth-status { min-height: 20px; margin: 4px 0 0; color: #ffcf67; font: 12px/1.5 'Courier New', monospace; }
</style>
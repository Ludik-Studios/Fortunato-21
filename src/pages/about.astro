---
import Layout from '../layouts/Layout.astro';

const teamMembers = [
	{ name: 'Jesús Rodríguez', role: 'Fundador', initials: 'JR' },
	{ name: 'Jorge Trujillo', role: 'Director creativo', initials: 'JT' },
	{ name: 'Ian Torres', role: 'Desarrollador principal', initials: 'IT' },
	{ name: 'Ricardo Isais', role: 'Diseñador de experiencia de usuario', initials: 'RI' },
	{ name: 'Enrique King', role: 'Responsable de marketing', initials: 'EK' },
	{ name: 'Gael Lozano', role: 'Responsable de producto', initials: 'GL' },
	{ name: 'Omar Muñoz', role: 'Responsable de producto', initials: 'OM' },
	{ name: 'Daphne Dávila', role: 'Responsable de producto', initials: 'DD' },
];
---

<Layout title="Sobre Ludik Studios | Ludik Hub" description="Conoce la misión, visión y equipo de Ludik Studios." lang="es" gaMeasurementId={import.meta.env.PUBLIC_GA4_MEASUREMENT_ID}>
	<main class="about-page" data-members={JSON.stringify(teamMembers)}>
		<header class="about-header">
			<a class="back-home" href="/" aria-label="Volver a Ludik Hub">
				<span class="back-arrow" aria-hidden="true">←</span>
				<span>LUDIK <b>HUB</b></span>
			</a>
			<nav class="about-nav" aria-label="Navegación principal">
				<a href="/">Inicio</a>
				<a href="/about/" aria-current="page">Acerca de Ludik</a>
			</nav>
			<span class="header-note">ESTUDIO INDIE · FUNDADO EN 2025</span>
		</header>

		<section class="about-intro" aria-labelledby="about-title">
			<div class="about-copy">
				<p class="section-kicker"><span></span> DETRÁS DE LOS JUEGOS</p>
				<h1 id="about-title">Sobre <em>Ludik Studios</em></h1>
				<p class="about-description">Somos una empresa independiente de desarrollo de videojuegos, fundada en 2025. Creamos juegos entretenidos y de calidad con un estilo retro y personal. Somos un grupo de personas que busca expandir el entretenimiento y compartirlo con el mundo de una forma diferente.</p>
			</div>
				<div class="king-art" role="img" aria-label="Ilustración de una carta del rey de diamantes">
				<div class="king-card">
					<span class="king-corner">K<i>♦</i></span>
					<span class="king-suit">♦</span>
					<span class="king-mark" aria-hidden="true">✦</span>
					<span class="king-corner king-corner-bottom">K<i>♦</i></span>
				</div>
				<span class="king-orbit orbit-a"></span>
				<span class="king-orbit orbit-b"></span>
				<span class="king-caption">EL REY ROJO / LU-01</span>
			</div>
		</section>

		<section class="mvv-section" aria-label="Misión, visión y valores">
			<article class="mvv-block">
				<p class="section-kicker">01 / PROPÓSITO</p>
				<h2>Misión</h2>
				<p>En Ludik Studios creamos experiencias de juego únicas e inmersivas a través de videojuegos independientes de alta calidad. Nos enfocamos en propuestas innovadoras para jóvenes apasionados por la tecnología, la ciencia ficción y los desafíos complejos.</p>
			</article>
			<article class="mvv-block">
				<p class="section-kicker">02 / FUTURO</p>
				<h2>Visión</h2>
				<p>Queremos ser un referente de la industria indie, reconocidos por nuestra creatividad, calidad e innovación. Aspiramos a construir una comunidad sólida y ganarnos un lugar en el mundo de los videojuegos con experiencias auténticas.</p>
			</article>
			<article class="mvv-block values-block">
				<p class="section-kicker">03 / PRINCIPIOS</p>
				<h2>Valores</h2>
				<ol class="values-list">
					<li>Calidad</li>
					<li>Compromiso</li>
					<li>Responsabilidad</li>
					<li>Innovación</li>
					<li>Respeto</li>
					<li>Creatividad</li>
				</ol>
			</article>
		</section>

		<section class="team-section" aria-labelledby="team-title">
			<div class="team-heading">
				<div>
					<p class="section-kicker"><span></span> LAS PERSONAS DETRÁS DEL PIXEL</p>
					<h2 id="team-title">Nuestro equipo</h2>
				</div>
				<span class="team-count">08 CREATIVOS</span>
			</div>
			<div class="team-carousel" data-carousel role="group" aria-label="Carrusel del equipo">
				<button class="carousel-arrow" type="button" data-direction="-1" aria-label="Integrante anterior">‹</button>
				<div class="team-profile" aria-live="polite">
					<div class="team-portrait" data-portrait data-tone="0" aria-hidden="true">
						<span data-initials>JR</span><i>✦</i>
					</div>
					<div class="profile-copy">
						<p class="profile-index" data-profile-index>01 / 08</p>
						<h3 data-member-name>Jesús Rodríguez</h3>
								<p data-member-role>Fundador</p>
					</div>
				</div>
				<button class="carousel-arrow" type="button" data-direction="1" aria-label="Siguiente integrante">›</button>
			</div>
			<div class="team-dots" role="group" aria-label="Seleccionar integrante del equipo">
				{teamMembers.map((member, index) => (
					<button class:list={['team-dot', { active: index === 0 }]} type="button" data-member-index={index} aria-label={`Ver a ${member.name}`} aria-pressed={index === 0}></button>
				))}
			</div>
		</section>

		<footer class="about-footer">
			<div>
				<p class="section-kicker">SIGAMOS EN CONTACTO</p>
				<h2>Conectemos.</h2>
			</div>
			<div class="social-links" aria-label="Redes sociales de Ludik Studios">
				<a href="https://facebook.com" target="_blank" rel="noreferrer" aria-label="Facebook">f</a>
				<a href="https://instagram.com" target="_blank" rel="noreferrer" aria-label="Instagram">◎</a>
				<a href="https://x.com" target="_blank" rel="noreferrer" aria-label="X">𝕏</a>
				<a href="https://linkedin.com" target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
			</div>
		</footer>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) {
		min-width: 320px;
		min-height: 100vh;
		margin: 0;
		color: #f4f2ff;
		background-color: #07172d;
		background-image:
			radial-gradient(1px 1px at 8% 18%, rgba(224,240,255,.8) 99%, transparent),
			radial-gradient(1px 1px at 24% 73%, rgba(224,240,255,.7) 99%, transparent),
			radial-gradient(1px 1px at 49% 12%, rgba(224,240,255,.8) 99%, transparent),
			radial-gradient(1px 1px at 73% 43%, rgba(224,240,255,.7) 99%, transparent),
			radial-gradient(1px 1px at 92% 81%, rgba(224,240,255,.8) 99%, transparent),
			linear-gradient(155deg, #061326, #0b1d38 64%, #141a38);
		font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;
	}
	.about-page { width: min(1160px, 100%); margin: auto; padding: 26px 28px 0; }
	.about-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-bottom: 22px; border-bottom: 1px solid rgba(255,255,255,.16); }
	.back-home { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: 13px; font-weight: 900; letter-spacing: 1.3px; text-decoration: none; }
	.back-home b { color: #ffcb76; }
	.back-arrow { color: #ffcb76; font-size: 22px; }
	.about-nav { display: flex; align-items: center; gap: 8px; }
	.about-nav a { padding: 8px 10px; border: 1px solid transparent; border-radius: 3px; color: #e2e8f7; font-size: 12px; font-weight: 800; text-decoration: none; white-space: nowrap; }
	.about-nav a:hover, .about-nav a[aria-current='page'] { border-color: rgba(255,203,118,.42); background: rgba(255,203,118,.1); color: #ffcb76; }
	.header-note, .section-kicker, .team-count, .profile-index { color: #b5bdd5; font-family: 'Courier New', monospace; font-size: 11px; font-weight: 700; letter-spacing: 1.3px; }
	.about-intro { display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: clamp(36px, 7vw, 92px); padding: clamp(56px, 9vw, 112px) 0 86px; }
	.about-copy { max-width: 640px; }
	.section-kicker { display: flex; align-items: center; gap: 9px; margin: 0 0 18px; }
	.section-kicker span { width: 8px; height: 8px; border-radius: 50%; background: #ef596a; box-shadow: 0 0 14px rgba(239,89,106,.7); }
	.about-title, .about-copy h1 { margin: 0; font-family: Impact, 'Arial Black', sans-serif; font-size: clamp(44px, 6vw, 76px); font-weight: 900; line-height: .98; text-transform: uppercase; }
	.about-copy h1 em { color: #ffca63; font-style: normal; }
	.about-description { max-width: 620px; margin: 26px 0 0; color: #e2e5f0; font-size: 17px; line-height: 1.8; }
	.king-art { min-height: 310px; position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.15); border-radius: 8px; background: radial-gradient(ellipse at 50% 48%, rgba(211,59,85,.23), transparent 45%), linear-gradient(145deg, rgba(28,47,100,.78), rgba(20,24,62,.82)); display: grid; place-items: center; }
	.king-card { width: 154px; height: 228px; position: relative; z-index: 1; border: 2px solid #fff5df; border-radius: 10px; background: linear-gradient(145deg,#fffaf0,#f3e7d2); box-shadow: 0 20px 48px rgba(0,0,0,.36); transform: rotate(-7deg); }
	.king-corner { position: absolute; top: 12px; left: 13px; display: grid; justify-items: center; color: #22243a; font: 700 24px/.85 Georgia,serif; }
	.king-corner i { color: #cf344f; font: normal 18px/.9 Georgia,serif; }
	.king-suit { position: absolute; top: 50%; left: 50%; color: #cf344f; font-size: 76px; line-height: 1; transform: translate(-50%,-55%); }
	.king-mark { position: absolute; inset: 18px; border: 1px solid rgba(207,52,79,.28); border-radius: 50%; color: rgba(207,52,79,.45); display: grid; place-items: center; font-size: 112px; }
	.king-corner-bottom { top: auto; left: auto; right: 13px; bottom: 12px; transform: rotate(180deg); }
	.king-orbit { position: absolute; width: 85%; height: 42%; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; }
	.orbit-a { transform: rotate(28deg); }
	.orbit-b { transform: rotate(-38deg); }
	.king-caption { position: absolute; left: 18px; bottom: 16px; color: rgba(255,255,255,.65); font: 700 9px 'Courier New',monospace; letter-spacing: 1.5px; }
	.mvv-section { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 34px; padding: 34px 0 70px; border-top: 1px solid rgba(255,255,255,.18); border-bottom: 1px solid rgba(255,255,255,.18); }
	.mvv-block { min-width: 0; }
	.mvv-block .section-kicker { color: #8d9abb; font-size: 10px; }
	.mvv-block h2, .team-heading h2, .about-footer h2 { margin: 0 0 14px; color: #ffcf67; font-family: Impact, 'Arial Black', sans-serif; font-size: 31px; font-weight: 800; text-transform: uppercase; }
	.mvv-block > p:last-child { margin: 0; color: #d9deed; font-size: 14px; line-height: 1.8; }
	.values-list { margin: 0; padding: 0; list-style: none; counter-reset: value; display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; }
	.values-list li { counter-increment: value; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,.12); color: #e4e8f3; font-size: 13px; }
	.values-list li::before { content: '0' counter(value) ' / '; margin-right: 5px; color: #ef6873; font-family: 'Courier New',monospace; font-size: 10px; }
	.team-section { padding: 76px 0 64px; }
	.team-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; }
	.team-heading h2 { margin: 0; font-size: clamp(34px,5vw,52px); }
	.team-count { padding-bottom: 7px; }
	.team-carousel { min-height: 300px; margin: 30px auto 18px; display: grid; grid-template-columns: 54px minmax(0,1fr) 54px; align-items: center; gap: 22px; }
	.carousel-arrow { width: 46px; height: 46px; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; background: rgba(18,34,72,.75); color: #ffcf67; cursor: pointer; font-size: 29px; line-height: 1; transition: background .2s, transform .2s; }
	.carousel-arrow:hover { background: #263f83; transform: scale(1.06); }
	.team-profile { min-height: 260px; padding: 22px clamp(18px,5vw,64px); border: 1px solid rgba(255,255,255,.13); border-radius: 8px; background: linear-gradient(115deg,rgba(18,34,72,.76),rgba(31,39,88,.48)); display: flex; align-items: center; justify-content: center; gap: clamp(22px,6vw,72px); }
	.team-portrait { width: 170px; height: 196px; flex: 0 0 auto; position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.45); border-radius: 84px 84px 12px 12px; background: linear-gradient(155deg,#df6271,#49346f 68%); display: grid; place-items: center; box-shadow: 0 16px 40px rgba(0,0,0,.24); transition: background .35s; }
	.team-portrait::before { content: ''; position: absolute; width: 92px; height: 112px; left: 39px; bottom: -20px; border-radius: 48% 48% 20% 20%; background: rgba(9,20,45,.68); }
	.team-portrait::after { content: ''; position: absolute; width: 56px; height: 64px; left: 57px; top: 38px; border-radius: 48% 48% 44% 44%; background: #f0c8a6; box-shadow: 0 -12px 0 2px rgba(24,20,43,.88); }
	.team-portrait > span { position: relative; z-index: 1; margin-top: 126px; color: #fff; font: 900 12px 'Courier New',monospace; letter-spacing: 2px; }
	.team-portrait i { position: absolute; z-index: 2; top: 20px; right: 22px; color: #ffe18d; font-size: 20px; font-style: normal; }
	.team-portrait[data-tone='1'] { background: linear-gradient(155deg,#549ab0,#35386d 70%); }
	.team-portrait[data-tone='2'] { background: linear-gradient(155deg,#c79b53,#65436c 70%); }
	.team-portrait[data-tone='3'] { background: linear-gradient(155deg,#637dc0,#483c78 70%); }
	.team-portrait[data-tone='4'] { background: linear-gradient(155deg,#55a386,#364b78 70%); }
	.team-portrait[data-tone='5'] { background: linear-gradient(155deg,#d28355,#633b6f 70%); }
	.team-portrait[data-tone='6'] { background: linear-gradient(155deg,#8b6fc0,#354578 70%); }
	.team-portrait[data-tone='7'] { background: linear-gradient(155deg,#c46b91,#3c407a 70%); }
	.profile-copy { min-width: 0; }
	.profile-index { margin: 0 0 12px; color: #ffcf67; }
	.profile-copy h3 { margin: 0; color: #fff; font-family: Impact,'Arial Black',sans-serif; font-size: clamp(26px,4vw,42px); line-height: 1.05; }
	.profile-copy > p:last-child { margin: 10px 0 0; color: #b9c5e0; font: 700 13px 'Courier New',monospace; }
	.team-dots { display: flex; justify-content: center; gap: 10px; }
	.team-dot { width: 9px; height: 9px; padding: 0; border: 1px solid rgba(255,255,255,.65); border-radius: 50%; background: transparent; cursor: pointer; }
	.team-dot.active { border-color: #ffcf67; background: #ffcf67; box-shadow: 0 0 12px rgba(255,207,103,.48); }
	.about-footer { min-height: 130px; margin-inline: calc((min(1160px, 100vw) - 100vw) / 2 - 28px); padding: 26px max(28px, calc((100vw - 1104px) / 2)); border-top: 1px solid rgba(255,255,255,.13); background: rgba(5,12,28,.68); display: flex; align-items: center; justify-content: space-between; gap: 20px; }
	.about-footer .section-kicker { margin-bottom: 8px; }
	.about-footer h2 { margin: 0; font-size: 26px; }
	.social-links { display: flex; gap: 12px; }
	.social-links a { width: 38px; height: 38px; border: 1px solid rgba(255,255,255,.36); border-radius: 50%; color: #fff; display: grid; place-items: center; font: 700 15px Arial,sans-serif; text-decoration: none; transition: color .2s, background .2s, transform .2s; }
	.social-links a:hover { border-color: #ffcf67; background: #ffcf67; color: #11182a; transform: translateY(-3px); }
	@media (max-width: 760px) {
		.about-page { padding-inline: 20px; }
		.about-header { flex-wrap: wrap; }
		.about-nav { order: 3; width: 100%; }
		.about-intro { grid-template-columns: 1fr; gap: 34px; padding: 64px 0 56px; }
		.king-art { min-height: 280px; }
		.mvv-section { grid-template-columns: 1fr; gap: 30px; padding: 30px 0 46px; }
		.team-section { padding: 56px 0 48px; }
		.team-carousel { grid-template-columns: 40px minmax(0,1fr) 40px; gap: 8px; }
		.carousel-arrow { width: 38px; height: 38px; }
		.team-profile { padding: 20px 12px; flex-direction: column; gap: 18px; text-align: center; }
		.about-footer { margin-inline: -20px; padding-inline: 20px; }
		.team-portrait { width: 142px; height: 166px; }
		.team-portrait::before { left: 25px; }
		.team-portrait::after { left: 43px; }
		.team-portrait > span { margin-top: 106px; }
		.profile-index { margin-bottom: 8px; }
	}
	@media (max-width: 480px) {
		.about-page { padding-inline: 16px; }
		.header-note { order: 2; }
		.header-note { max-width: 122px; text-align: right; font-size: 9px; line-height: 1.6; }
		.about-copy h1 { font-size: 44px; }
		.about-description { font-size: 15px; }
		.team-heading { align-items: start; flex-direction: column; }
		.team-count { padding: 0; }
		.about-footer { margin-inline: -16px; padding-inline: 16px; align-items: start; flex-direction: column; }
		.social-links { gap: 10px; }
	}
	@media (prefers-reduced-motion: reduce) {
		*, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
	}
</style>

<script>
	const root = document.querySelector('.about-page');
	const members = JSON.parse(root?.getAttribute('data-members') ?? '[]');
	const nameNode = document.querySelector('[data-member-name]');
	const roleNode = document.querySelector('[data-member-role]');
	const initialsNode = document.querySelector('[data-initials]');
	const indexNode = document.querySelector('[data-profile-index]');
	const portrait = document.querySelector('[data-portrait]');
	const dots = Array.from(document.querySelectorAll('[data-member-index]'));
	const carousel = document.querySelector<HTMLElement>('[data-carousel]');
	let currentIndex = 0;

	function showMember(index: number) {
		currentIndex = (index + members.length) % members.length;
		const member = members[currentIndex];
		if (!member || !nameNode || !roleNode || !initialsNode || !indexNode || !portrait) return;

		nameNode.textContent = member.name;
		roleNode.textContent = member.role;
		initialsNode.textContent = member.initials;
		indexNode.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(members.length).padStart(2, '0')}`;
		portrait.setAttribute('data-tone', String(currentIndex));
		dots.forEach((dot, dotIndex) => {
			const isActive = dotIndex === currentIndex;
			dot.classList.toggle('active', isActive);
			dot.setAttribute('aria-pressed', String(isActive));
		});
	}

	carousel?.querySelectorAll('[data-direction]').forEach((button) => {
		button.addEventListener('click', () => {
			showMember(currentIndex + Number(button.getAttribute('data-direction')));
		});
	});

	dots.forEach((dot) => {
		dot.addEventListener('click', () => showMember(Number(dot.getAttribute('data-member-index'))));
	});

</script>
